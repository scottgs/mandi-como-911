[Unit]
Description=Fetch Columbia Police Dispatch calls for mandi_geo
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=__INSTALL_USER__
EnvironmentFile=/etc/mandi/como-911.env
Environment=HA_WWW_DIR=__HA_WWW_DIR__
ExecStart=/usr/bin/python3 __REPO_DIR__/fetch/columbia-911-police-fetch.py
